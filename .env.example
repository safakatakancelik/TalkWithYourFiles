# Copy this file to .env and fill in the keys you have. One provider is enough.
# Keys here are used automatically; otherwise you can enter them in the app's sidebar.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: change the default model per provider (can also be changed in the app).
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENROUTER_MODEL=openrouter/auto
